{
  "name": "claude-code-ui",
  "version": "5.4.0",
  "private": true,
  "description": "A local desktop chat interface for Claude Code with model selection, screenshot vision, voice input, and file attachments.",
  "author": "Kanye-QA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanye-QA/claude-code-ui.git"
  },
  "homepage": "https://github.com/Kanye-QA/claude-code-ui#readme",
  "bugs": {
    "url": "https://github.com/Kanye-QA/claude-code-ui/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "pack:win": "npm run build && electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "local.claudecode.ui",
    "productName": "Claude Code UI",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Claude-Code-UI-5.4-portable.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
